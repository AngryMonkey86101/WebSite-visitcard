---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { assetUrl, localizedUrl, pathWithoutLocale, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const t = useTranslations(locale);
const pageTitle = title ? `${title} — ${t('site.title')}` : t('site.title');
const pageDescription = description ?? t('site.description');
const path = pathWithoutLocale(Astro.url.pathname);
const alternates = (['ru', 'en'] as const).map((l) => ({
  locale: l,
  href: new URL(localizedUrl(l, path), Astro.site).href,
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href={assetUrl('favicon.svg')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.locale} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
  </head>
  <body class="relative min-h-screen overflow-x-hidden">
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { assetUrl, localizedUrl, pathWithoutLocale, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Картинка превью из src/pages/og: путь без .png, по умолчанию — картинка главной. */
  ogImage?: string;
  /** Структурированные данные schema.org для поисковиков. */
  jsonLd?: Record<string, unknown>;
  /** Не индексировать страницу (404). */
  noindex?: boolean;
}

const { locale, title, description, ogImage = locale, jsonLd, noindex = false } = Astro.props;
const t = useTranslations(locale);
const pageTitle = title ? `${title} — ${t('site.title')}` : t('site.title');
const pageDescription = description ?? t('site.description');
const path = pathWithoutLocale(Astro.url.pathname);
const alternates = (['ru', 'en'] as const).map((l) => ({
  locale: l,
  href: new URL(localizedUrl(l, path), Astro.site).href,
}));
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(assetUrl(`og/${ogImage}.png`), Astro.site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href={assetUrl('favicon.svg')} />
    <meta name="theme-color" content="#000000" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.locale} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:site_name" content={t('site.title')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={assetUrl('sitemap-index.xml')} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="relative min-h-screen overflow-x-hidden">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-accent px-6 py-3 font-display font-bold text-bg focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      {t('a11y.skip')}
    </a>
    <Header locale={locale} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

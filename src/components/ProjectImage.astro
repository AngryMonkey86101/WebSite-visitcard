---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Обложка или скриншот проекта. Пока картинки нет — заглушка 16:9 в стиле макета.
interface Props {
  image?: ImageMetadata;
  alt: string;
  label: string;
  caption?: string;
  class?: string;
  eager?: boolean;
}

const { image, alt, label, caption, class: className, eager = false } = Astro.props;
---

<div
  class:list={[
    'relative aspect-video w-full overflow-hidden rounded-2xl bg-bg shadow-normal ring-1 ring-white/10',
    className,
  ]}
>
  {image ? (
    <Image
      src={image}
      alt={alt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1280px) 1140px, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      class="size-full object-cover"
    />
  ) : (
    <div class="flex size-full flex-col items-center justify-center gap-3 bg-[radial-gradient(ellipse_at_100%_0%,var(--color-wave-top)_0%,var(--color-wave-mid)_25%,var(--color-wave-deep)_50%,transparent_75%)] p-6 text-center">
      <span class="font-display text-2xl font-light tracking-[0.25em] uppercase md:text-4xl">
        {label}
      </span>
      {caption && <span class="text-sm text-white/60">{caption}</span>}
    </div>
  )}
</div>

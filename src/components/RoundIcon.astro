---
// Круглая иконка со свечением из блока «ДЛЯ КОГО» макета:
// три кольца акцентного цвета, чёрный круг в центре и белая иконка.
export type IconName = 'ai' | 'telegram' | 'web' | 'rocket' | 'wrench';

interface Props {
  icon: IconName;
  title: string;
  text?: string;
}

const { icon, title, text } = Astro.props;

// Пиктограммы 24 × 24, контурные, как в lucide.
const paths: Record<IconName, string[]> = {
  ai: [
    'M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z',
    'M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z',
    'M5 2l.6 1.4L7 4l-1.4.6L5 6l-.6-1.4L3 4l1.4-.6z',
  ],
  telegram: ['M21.5 3.5L2.5 11l7 2.5 2.5 7 9.5-17z', 'M9.5 13.5l12-10'],
  web: ['M3 5h18v14H3z', 'M3 9h18', 'M6 7h.01', 'M8.5 7h.01', 'M9 13l-2 2 2 2', 'M15 13l2 2-2 2'],
  rocket: [
    'M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2.1-.1-2.9-.8-.8-2.1-.8-2.9-.1z',
    'M12 15l-3-3a22 22 0 0 1 2-3.9A12.9 12.9 0 0 1 22 2c0 2.7-.8 7.5-6 11a22.4 22.4 0 0 1-4 2z',
    'M9 12H4s.6-3 2-4c1.6-1.1 5 0 5 0',
    'M12 15v5s3-.6 4-2c1.1-1.6 0-5 0-5',
  ],
  wrench: [
    'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9z',
  ],
};
---

<li class="flex flex-col items-center gap-6 text-center md:gap-8">
  <div
    class="relative grid size-40 place-items-center rounded-full bg-accent/15 shadow-[0_0_60px_#00c7fe40] md:size-50 xl:size-70"
    aria-hidden="true"
  >
    <div class="grid size-[86%] place-items-center rounded-full bg-accent/40">
      <div class="grid size-[83%] place-items-center rounded-full bg-accent/90">
        <div class="grid size-[80%] place-items-center rounded-full bg-bg">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-[55%]"
          >
            {paths[icon].map((d) => (
              <path d={d} />
            ))}
          </svg>
        </div>
      </div>
    </div>
  </div>
  <div class="flex max-w-[320px] flex-col gap-3">
    <h3 class="font-body text-xl font-semibold md:text-2xl">{title}</h3>
    {text && <p class="text-body text-white/70">{text}</p>}
  </div>
</li>

---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'primary' | 'secondary';
}

const { variant = 'primary', class: className, ...attrs } = Astro.props;
---

{variant === 'primary' ? (
  <a
    class:list={[
      'inline-flex min-w-[250px] items-center justify-center rounded-[40px] bg-accent px-10 py-[22px] font-display text-button font-bold text-bg uppercase transition hover:shadow-hover hover:brightness-110',
      className,
    ]}
    {...attrs}
  >
    <slot />
  </a>
) : (
  <a
    class:list={[
      'group inline-flex items-center gap-5 font-display text-button font-bold text-accent uppercase',
      className,
    ]}
    {...attrs}
  >
    <span class="flex size-[53px] items-center justify-center rounded-full border-2 border-accent transition group-hover:bg-accent group-hover:text-bg">
      <svg width="11" height="16" viewBox="0 0 11 16" fill="currentColor" aria-hidden="true">
        <path d="M0 0l11 8-11 8z" />
      </svg>
    </span>
    <slot />
  </a>
)}

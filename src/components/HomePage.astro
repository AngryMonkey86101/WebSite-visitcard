---
import Base from '../layouts/Base.astro';
import AllProjects from './AllProjects.astro';
import Button from './Button.astro';
import ProjectsSection from './ProjectsSection.astro';
import RoundIcon, { type IconName } from './RoundIcon.astro';
import Wave from './Wave.astro';
import { telegramUrl, useTranslations, type Locale } from '../i18n';
import { personLd } from '../lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const jsonLd = {
  '@context': 'https://schema.org',
  ...personLd(locale, Astro.site),
  description: t('site.description'),
};

const skills = [
  { icon: 'ai', title: t('skills.ai'), text: t('skills.ai.text') },
  { icon: 'telegram', title: t('skills.bots'), text: t('skills.bots.text') },
  { icon: 'web', title: t('skills.web'), text: t('skills.web.text') },
] satisfies { icon: IconName; title: string; text: string }[];
const help = [
  { icon: 'rocket', title: t('help.turnkey'), text: t('help.turnkey.text') },
  { icon: 'wrench', title: t('help.support'), text: t('help.support.text') },
] satisfies { icon: IconName; title: string; text: string }[];
---

<Base locale={locale} jsonLd={jsonLd}>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[1100px] overflow-hidden"
    aria-hidden="true"
  >
    <Wave id="wave-top" class="top-0 left-0 w-[85vw] max-w-[800px] md:left-[7vw]" />
    <Wave
      id="wave-right"
      class="top-[260px] -right-[150px] w-[320px] rotate-90 opacity-70 md:top-[200px] md:-right-[225px] md:w-[640px] md:opacity-100"
    />
  </div>

  <section class="relative z-10">
    <div class="container-site flex min-h-[70vh] flex-col justify-center gap-8 py-16 md:py-24">
      <h1 class="flex flex-col gap-4">
        <span class="font-display text-[2.5rem] leading-tight font-light tracking-[0.25em] uppercase md:text-display">
          {t('hero.name')}
        </span>
        <span class="font-display text-xl tracking-[0.25em] text-accent uppercase md:text-display-sub md:tracking-[9px]">
          {t('hero.role')}
        </span>
      </h1>
      <p class="max-w-[440px] text-lg md:text-lead">{t('hero.lead')}</p>
      <div class="mt-6 flex flex-wrap items-center gap-8 md:gap-[60px]">
        <Button href="#projects">{t('hero.projects')}</Button>
        <Button variant="secondary" href={telegramUrl}>
          {t('hero.contact')}
        </Button>
      </div>
    </div>
  </section>

  <section id="skills" class="relative z-10 scroll-mt-8 py-24 md:py-[120px]">
    <div class="container-site">
      <h2 class="text-center text-2xl font-bold md:text-h2">{t('skills.title')}</h2>
      <ul class="mt-16 grid justify-items-center gap-16 md:mt-24 md:grid-cols-3 md:gap-10">
        {skills.map((item) => (
          <RoundIcon {...item} />
        ))}
      </ul>
    </div>
  </section>

  <ProjectsSection locale={locale} />
  <AllProjects locale={locale} />

  <section id="help" class="relative z-10 scroll-mt-8 py-24 md:py-[120px]">
    <div class="container-site">
      <h2 class="text-center text-2xl font-bold md:text-h2">{t('help.title')}</h2>
      <ul class="mx-auto mt-16 grid max-w-[900px] justify-items-center gap-16 md:mt-24 md:grid-cols-2 md:gap-10">
        {help.map((item) => (
          <RoundIcon {...item} />
        ))}
      </ul>
    </div>
  </section>

  <section id="contacts" class="relative z-10 scroll-mt-8 py-24 md:py-[120px]">
    <div class="container-site flex flex-col items-center gap-8 text-center">
      <h2 class="text-2xl font-bold md:text-h2">{t('contacts.title')}</h2>
      <p class="text-lg md:text-lead">{t('contacts.text')}</p>
      <Button href={telegramUrl}>{t('contacts.telegram')}</Button>
    </div>
  </section>
</Base>

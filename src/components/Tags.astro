---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <li class="rounded-full border border-accent/60 px-3 py-1 font-display text-sm text-accent">
        {tag}
      </li>
    ))}
  </ul>
)}

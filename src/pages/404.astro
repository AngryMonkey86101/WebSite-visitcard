---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { localizedUrl, useTranslations } from '../i18n';

const t = useTranslations('ru');
const en = useTranslations('en');
---

<Base locale="ru" title={t('notFound.title')}>
  <section class="container-site flex min-h-[60vh] flex-col items-center justify-center gap-6 text-center">
    <p class="font-display text-display-sub tracking-[9px] text-accent">404</p>
    <h1 class="text-2xl font-bold md:text-h2">{t('notFound.title')}</h1>
    <p class="text-white/60">{en('notFound.title')}</p>
    <Button href={localizedUrl('ru')}>{t('notFound.back')}</Button>
  </section>
</Base>
